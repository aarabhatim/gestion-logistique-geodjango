# ═══════════════════════════════════════════════════════
# DeliverMap — Variables d'environnement
# Copiez en .env et remplissez les valeurs
# ═══════════════════════════════════════════════════════

# ─── Django ─────────────────────────────────────────────
SECRET_KEY=delivermap-secret-change-this-in-production-2025
DEBUG=True

# ─── PostgreSQL + PostGIS ───────────────────────────────
DB_HOST=localhost
DB_NAME=logistique_db
DB_USER=postgres
DB_PASS=Hatim2005@
DB_PORT=5432

# ─── Redis (Channels + Celery) ──────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OSRM (routing) ─────────────────────────────────────
# Serveur public (démo) ou votre instance locale
OSRM_BASE_URL=http://router.project-osrm.org

# ─── Stripe (paiements) ─────────────────────────────────
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook

# ─── Commission plateforme ───────────────────────────────
PLATFORM_COMMISSION_RATE=0.15

# ─── Chatbot LLM (Mistral) ──────────────────────────────
# Clé gratuite sur https://console.mistral.ai/
# Laisser vide => le chatbot bascule sur le moteur local (sans API)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
