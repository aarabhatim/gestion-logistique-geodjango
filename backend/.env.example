# ═══════════════════════════════════════════════════════════════════════════════
# DeliverMap — Variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs réelles.
# Ne commitez JAMAIS le fichier .env dans git.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Django ─────────────────────────────────────────────────────────────────
# Générez une clé sécurisée : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changez-cette-cle-en-production

# True en développement, False en production
DEBUG=True

# En production : ALLOWED_HOSTS=mon-domaine.com,www.mon-domaine.com
# ALLOWED_HOSTS=localhost,127.0.0.1

# ─── PostgreSQL + PostGIS ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=logistique_db
DB_USER=postgres
DB_PASS=votre_mot_de_passe_postgres
DB_PORT=5432

# ─── Redis (Channels + Celery) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS (en production, désactiver ALLOW_ALL et lister les origines) ────────
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://mon-domaine.com,https://www.mon-domaine.com

# ─── OSRM (routing itinéraire) ───────────────────────────────────────────────
# Serveur public pour demo ; remplacez par votre instance en production
OSRM_BASE_URL=http://router.project-osrm.org

# ─── Stripe (paiements) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook

# ─── Commission plateforme (%) ───────────────────────────────────────────────
COMMISSION_RATE=0.15

# ─── Email ───────────────────────────────────────────────────────────────────
# En dev : console backend (pas d'envoi réel)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# En production :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre.email@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application
DEFAULT_FROM_EMAIL=DeliverMap <noreply@delivermap.ma>
